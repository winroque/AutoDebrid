{
  "manifest_version": 3,
  "name": "AutoDebrid — Real-Debrid",
  "version": "1.0.0",
  "description": "Converte links de hosters (1fichier, Rapidgator, Mega etc.) em links diretos via Real-Debrid, com suporte a mirrors.",
  "permissions": [
    "storage",
    "clipboardWrite",
    "contextMenus"
  ],
  "host_permissions": [
    "https://api.real-debrid.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["https://real-debrid.com/*", "https://*.real-debrid.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AutoDebrid"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
